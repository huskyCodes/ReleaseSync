<UserControl x:Class="ReleaseSync.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ReleaseSync.UI"
             xmlns:app="clr-namespace:ReleaseSync">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Margin="32,14,32,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Updates" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0">
                    <Run Text="{Binding UpdateCount, Mode=OneWay}"/><Run Text=" available  ·  "/><Run Text="{Binding LastCheckText, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="40" Padding="20,0" VerticalAlignment="Center"
                    Command="{Binding UpdateAllCommand}" Visibility="{Binding NoUpdates, Converter={StaticResource InvBoolVis}}" IsEnabled="{Binding IsUpdatingAll, Converter={StaticResource Inv}}">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" Margin="0,0,9,0"/><TextBlock Text="Update everything"/></StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding NoUpdates, Converter={StaticResource InvBoolVis}}">
            <ItemsControl ItemsSource="{Binding UpdatesView}" Margin="32,0,32,32" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="{DynamicResource CardPad}" Margin="0,0,0,12" Background="{DynamicResource CardBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ContentControl ContentTemplate="{StaticResource AvatarTemplate}" Content="{Binding}" Width="48" Height="48" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Margin="16,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" FontSize="15.5"/>
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="9,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VersionText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextOnSurface}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource Faint}">
                                        <Run Text="{Binding FullName, Mode=OneWay}"/><Run Text="  ·  released "/><Run Text="{Binding PublishedText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding NotesPreview}" Style="{StaticResource Dim}" Margin="0,10,0,0" MaxHeight="64" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource Faint}" Margin="0,6,0,0" Text="Open Details to read every change since your version, or to pick an older release." />

                                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" Margin="0,12,0,0" MaxWidth="420" HorizontalAlignment="Left">
                                        <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}"/>
                                        <TextBlock Text="{Binding BusyText}" Style="{StaticResource Faint}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="Skip" Margin="0,0,8,0" Height="36" Padding="16,0" ToolTip="Skip this version"
                                            Command="{Binding SkipCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                                    <Button Content="Details" Margin="0,0,8,0" Height="36" Padding="16,0"
                                            Command="{Binding OpenCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource PrimaryButton}" Height="36" Padding="18,0" IsEnabled="{Binding CanInstall}"
                                            Command="{Binding InstallCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Update"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,90" MaxWidth="440" Visibility="{Binding NoUpdates, Converter={StaticResource BoolVis}}">
            <Border Width="84" Height="84" CornerRadius="42" Background="{DynamicResource SuccessSoftBrush}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="38" Foreground="{DynamicResource SuccessBrush}"/>
            </Border>
            <TextBlock Text="You're all caught up" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,22,0,6"/>
            <TextBlock Text="{Binding LastCheckText}" Style="{StaticResource Dim}" HorizontalAlignment="Center" FontSize="13.5"/>
            <Button Style="{StaticResource PrimaryButton}" Height="40" Padding="22,0" HorizontalAlignment="Center" Margin="0,20,0,0" Command="{Binding CheckAllCommand}"
                    IsEnabled="{Binding IsChecking, Converter={StaticResource Inv}}">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,9,0"/><TextBlock Text="{Binding CheckButtonText}"/></StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
