<UserControl x:Class="ReleaseSync.Views.RepoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ReleaseSync.UI"
             xmlns:app="clr-namespace:ReleaseSync">
    <UserControl.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    </UserControl.Resources>
    <Border Style="{StaticResource Card}" Width="660" MaxWidth="720" CornerRadius="18" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect><DropShadowEffect BlurRadius="50" ShadowDepth="10" Opacity="0.45" Direction="270"/></Border.Effect>
        <Grid DataContext="{Binding RepoDetail}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- header -->
            <Grid Margin="28,24,20,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentControl ContentTemplate="{StaticResource AvatarTemplate}" Content="{Binding Info}" Width="52" Height="52" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Margin="16,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="21" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding FullName}" Style="{StaticResource Faint}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" VerticalAlignment="Top" ToolTip="Close (Esc)" Command="{Binding CloseDetailsCommand, Source={x:Static app:App.VM}}"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="560">
                <StackPanel Margin="28,4,28,22">
                    <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}" Margin="0,16,0,20">
                        <TextBlock Text="Loading repository…" Style="{StaticResource Dim}" Margin="0,0,0,14"/>
                        <ProgressBar IsIndeterminate="True"/>
                    </StackPanel>

                    <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="12" Padding="16,14" Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Visibility="{Binding HasInfo, Converter={StaticResource BoolVis}}">
                        <StackPanel DataContext="{Binding Info}">
                            <TextBlock Text="{Binding Description}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource DimBrush}" Visibility="{Binding HasDescription, Converter={StaticResource BoolVis}}"/>

                            <!-- stats -->
                            <UniformGrid Rows="1" Margin="0,18,0,0">
                                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,8,0" Background="{DynamicResource CardBrush}">
                                    <StackPanel><TextBlock Text="STARS" Style="{StaticResource Label}"/><TextBlock Text="{Binding StarsText}" Style="{StaticResource StatValue}" Margin="0,4,0,0"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,8,0" Background="{DynamicResource CardBrush}">
                                    <StackPanel><TextBlock Text="FORKS" Style="{StaticResource Label}"/><TextBlock Text="{Binding ForksText}" Style="{StaticResource StatValue}" Margin="0,4,0,0"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,8,0" Background="{DynamicResource CardBrush}">
                                    <StackPanel><TextBlock Text="OPEN ISSUES" Style="{StaticResource Label}"/><TextBlock Text="{Binding IssuesText}" Style="{StaticResource StatValue}" Margin="0,4,0,0"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="14,12" Background="{DynamicResource CardBrush}">
                                    <StackPanel><TextBlock Text="LAST UPDATE" Style="{StaticResource Label}"/><TextBlock Text="{Binding UpdatedText}" Style="{StaticResource StatValue}" FontSize="14" Margin="0,6,0,0"/></StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- facts -->
                            <WrapPanel Margin="0,16,0,0">
                                <Border Background="{DynamicResource SoftBrush}" CornerRadius="9" Padding="10,4" Margin="0,0,8,8" Visibility="{Binding HasLanguage, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE943;" FontSize="12" Margin="0,0,7,0" Foreground="{DynamicResource DimBrush}"/><TextBlock Text="{Binding Language}" FontSize="12"/></StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SoftBrush}" CornerRadius="9" Padding="10,4" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="12" Margin="0,0,7,0" Foreground="{DynamicResource DimBrush}"/><TextBlock Text="{Binding LicenseText}" FontSize="12"/></StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SoftBrush}" CornerRadius="9" Padding="10,4" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE787;" FontSize="12" Margin="0,0,7,0" Foreground="{DynamicResource DimBrush}"/><TextBlock Text="{Binding CreatedText, StringFormat='Created {0}'}" FontSize="12"/></StackPanel>
                                </Border>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding Topics}" Visibility="{Binding HasTopics, Converter={StaticResource BoolVis}}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="10,3" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource AccentTextOnSurface}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Height="36" Padding="14,0" Margin="0,0,8,8" Command="{Binding OwnerCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding OwnerLogin}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="13" Margin="0,0,9,0"/><TextBlock>
                                        <Run Text="More from "/><Run Text="{Binding OwnerLogin, Mode=OneWay}"/></TextBlock></StackPanel>
                                </Button>
                                <Button Height="36" Padding="14,0" Margin="0,0,8,8" Style="{StaticResource OutlineButton}" Command="{Binding GitHubCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="13" Margin="0,0,9,0"/><TextBlock Text="Open on GitHub"/></StackPanel>
                                </Button>
                                <Button Height="36" Padding="14,0" Margin="0,0,8,8" Style="{StaticResource OutlineButton}" Visibility="{Binding HasHomepage, Converter={StaticResource BoolVis}}"
                                        Command="{Binding OpenUrlCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding Homepage}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="13" Margin="0,0,9,0"/><TextBlock Text="Website"/></StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Margin="0,6,0,0" Visibility="{Binding HasHints, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="AT A GLANCE" Style="{StaticResource Label}" Margin="0,4,0,8"/>
                            <ItemsControl ItemsSource="{Binding Hints}" ItemTemplate="{StaticResource HintTemplate}" Focusable="False"/>
                        </StackPanel>

                        <!-- readme -->
                        <TextBlock Text="README" Style="{StaticResource Label}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource Card}" Padding="18,16" Background="{DynamicResource CardBrush}">
                            <StackPanel>
                                <ProgressBar IsIndeterminate="True" Visibility="{Binding ReadmeLoading, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="{Binding Readme}" TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource DimBrush}" Visibility="{Binding HasReadme, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="This repository doesn't have a README." Style="{StaticResource Dim}" Visibility="{Binding NoReadme, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,16">
                <Grid>
                    <Button HorizontalAlignment="Left" Height="40" Padding="16,0" Style="{StaticResource OutlineButton}" Command="{Binding DetailTryLaterCommand, Source={x:Static app:App.VM}}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{Binding TryLaterGlyph}" FontSize="13" Margin="0,0,9,0"/><TextBlock Text="{Binding TryLaterText}"/></StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close" Height="40" Padding="22,0" Command="{Binding CloseDetailsCommand, Source={x:Static app:App.VM}}"/>
                        <Button Style="{StaticResource PrimaryButton}" Height="40" Padding="22,0" Margin="10,0,0,0" Command="{Binding DetailAddCommand, Source={x:Static app:App.VM}}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{Binding AddGlyph}" FontSize="13" Margin="0,0,9,0"/><TextBlock Text="{Binding AddText}"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
