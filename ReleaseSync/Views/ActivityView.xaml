<UserControl x:Class="ReleaseSync.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="32,14,32,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Activity" Style="{StaticResource H1}"/>
                <TextBlock Text="Everything ReleaseSync has done this session — checks, installs and problems." Style="{StaticResource Dim}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Clear" Height="36" Padding="18,0" VerticalAlignment="Center" Command="{Binding ClearLogCommand}"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Log}" Margin="32,0,32,32" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="row" Style="{StaticResource Card}" CornerRadius="10" Padding="{DynamicResource RowPad}" Margin="0,0,0,8" Background="{DynamicResource CardBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ic" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14" Foreground="{DynamicResource AccentTextOnSurface}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource Faint}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="success"><Setter TargetName="ic" Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="error"><Setter TargetName="ic" Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="warn"><Setter TargetName="ic" Property="Foreground" Value="{DynamicResource WarnBrush}"/></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,90">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Log.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="36" Foreground="{DynamicResource FaintBrush}"/>
            <TextBlock Text="Nothing yet" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
            <TextBlock Text="Update checks and installs will show up here." Style="{StaticResource Dim}"/>
        </StackPanel>
    </Grid>
</UserControl>
