<UserControl x:Class="ReleaseSync.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ReleaseSync.UI"
             xmlns:app="clr-namespace:ReleaseSync">
    <UserControl.Resources>
        <Style x:Key="StarButton" TargetType="Button" BasedOn="{StaticResource SmallIconButton}">
            <Setter Property="Content" Value="&#xE734;"/>
            <Setter Property="ToolTip" Value="Add to favorites"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Pinned}" Value="True">
                    <Setter Property="Content" Value="&#xE735;"/>
                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                    <Setter Property="ToolTip" Value="Remove from favorites"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ContextMenu x:Key="AppMenu">
            <MenuItem Header="Open details" Command="{Binding OpenCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding ActionText}" Command="{Binding InstallCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}" Visibility="{Binding ShowAction, Converter={StaticResource BoolVis}}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Launch" Command="{Binding LaunchCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}" Visibility="{Binding CanLaunch, Converter={StaticResource BoolVis}}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="See file location" Command="{Binding LocationCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}" Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Skip this version" Command="{Binding SkipCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}" Visibility="{Binding HasUpdate, Converter={StaticResource BoolVis}}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Check for updates" Command="{Binding CheckCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Favorite / unfavorite" Command="{Binding PinCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE718;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Move to group" ItemsSource="{Binding MoveMenuOptions, Source={x:Static app:App.VM}}" DisplayMemberPath="Label" SubmenuOpened="MoveMenu_Opened">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14"/></MenuItem.Icon>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <EventSetter Event="Click" Handler="MoveItem_Click"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <Separator/>
            <MenuItem Header="More from this developer" Command="{Binding OwnerCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Repository details" Command="{Binding DetailsCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Open on GitHub" Command="{Binding GitHubCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Change repository…" Command="{Binding RelinkCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Mark as installed" Command="{Binding MarkInstalledCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Uninstall from this PC" Command="{Binding UninstallCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}" Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Hide from library" Command="{Binding HideCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}" Visibility="{Binding Hidden, Converter={StaticResource InvBoolVis}}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xED1A;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Unhide" Command="{Binding HideCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}" Visibility="{Binding Hidden, Converter={StaticResource BoolVis}}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Stop tracking (keeps it installed)" Command="{Binding RemoveCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Foreground="{DynamicResource DangerBrush}"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- ================= Card (grid view) ================= -->
        <DataTemplate x:Key="CardT">
            <Border x:Name="card" Style="{StaticResource Card}" Padding="{DynamicResource CardPad}" Cursor="Hand" ContextMenu="{StaticResource AppMenu}" Background="{DynamicResource CardBrush}"
                    MouseLeftButtonUp="Card_Click" PreviewMouseLeftButtonDown="Card_Down" MouseMove="Card_Move">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ContentControl ContentTemplate="{StaticResource AvatarTemplate}" Content="{Binding}" Width="{DynamicResource AvatarSize}" Height="{DynamicResource AvatarSize}"/>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" FontSize="{DynamicResource CardTitleSize}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" FontSize="11" Foreground="{DynamicResource WarnBrush}" Margin="6,2,0,0" Visibility="{Binding Pinned, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding FullName}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,-4,-6,0">
                            <Button Style="{StaticResource StarButton}" Command="{Binding PinCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE712;" Click="More_Click" ToolTip="More actions"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource Dim}" FontSize="{DynamicResource CardTextSize}" TextTrimming="CharacterEllipsis" MaxHeight="{DynamicResource DescHeight}" MinHeight="{DynamicResource DescHeight}" Margin="{DynamicResource DescMargin}"/>

                    <Grid Grid.Row="2" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8EC;" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding VersionText}" FontSize="{DynamicResource CardTextSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ContentControl Grid.Column="1" ContentTemplate="{StaticResource StatusPillTemplate}" Content="{Binding}" Margin="10,0,0,0"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="{DynamicResource ActionMargin}" MinHeight="{DynamicResource BtnHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <!-- busy -->
                        <StackPanel Grid.ColumnSpan="2" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource SmallIconButton}" Content="&#xE711;" Margin="8,0,0,0" ToolTip="Cancel"
                                        Command="{Binding CancelCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                            </Grid>
                            <TextBlock Text="{Binding BusyText}" Style="{StaticResource Faint}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <!-- idle -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource InvBoolVis}}">
                            <Button Style="{StaticResource PrimaryButton}" Padding="14,0" Height="{DynamicResource BtnHeight}" MinHeight="0" Visibility="{Binding ShowAction, Converter={StaticResource BoolVis}}"
                                    Command="{Binding InstallCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}" IsEnabled="{Binding CanInstall}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding ActionText}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BaseButton}" Padding="12,0" Height="{DynamicResource BtnHeight}" MinHeight="0" Content="Launch" Margin="8,0,0,0" Visibility="{Binding CanLaunch, Converter={StaticResource BoolVis}}"
                                    Command="{Binding LaunchCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Faint}" Text="{Binding PublishedText, StringFormat='Released {0}'}"
                                       Visibility="{Binding ShowAction, Converter={StaticResource BoolVis}}" Margin="12,0,0,0"/>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Faint}" Text="{Binding PublishedText, StringFormat='Released {0}'}"
                                       Visibility="{Binding ShowAction, Converter={StaticResource InvBoolVis}}" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Hidden}" Value="True"><Setter TargetName="card" Property="Opacity" Value="0.6"/></DataTrigger>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="card" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentSoftStrongBrush}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================= Row (list view) ================= -->
        <DataTemplate x:Key="RowT">
            <Border x:Name="card" Style="{StaticResource Card}" CornerRadius="12" Padding="{DynamicResource RowPad}" Cursor="Hand" ContextMenu="{StaticResource AppMenu}" Background="{DynamicResource CardBrush}"
                    MouseLeftButtonUp="Card_Click" PreviewMouseLeftButtonDown="Card_Down" MouseMove="Card_Move">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="Auto" MinWidth="170"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl ContentTemplate="{StaticResource AvatarTemplate}" Content="{Binding}" Width="{DynamicResource RowAvatarSize}" Height="{DynamicResource RowAvatarSize}"/>
                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" FontSize="11" Foreground="{DynamicResource WarnBrush}" Margin="6,2,0,0" Visibility="{Binding Pinned, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                        <ContentControl ContentTemplate="{StaticResource StatusPillTemplate}" Content="{Binding}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" Width="120" VerticalAlignment="Center">
                            <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}"/>
                        </StackPanel>
                        <Button Style="{StaticResource PrimaryButton}" Padding="14,0" Height="{DynamicResource BtnHeight}" MinHeight="0" Visibility="{Binding ShowAction, Converter={StaticResource BoolVis}}" IsEnabled="{Binding CanInstall}"
                                Command="{Binding InstallCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}" Content="{Binding ActionText}"/>
                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE768;" ToolTip="Launch" Margin="6,0,0,0" Visibility="{Binding CanLaunch, Converter={StaticResource BoolVis}}"
                                Command="{Binding LaunchCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource StarButton}" Margin="6,0,0,0" Command="{Binding PinCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE712;" Margin="2,0,0,0" Click="More_Click" ToolTip="More actions"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="card" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentSoftStrongBrush}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ItemHost" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource CardT}"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Settings.ViewMode, Source={x:Static app:App.VM}}" Value="List">
                    <Setter Property="ContentTemplate" Value="{StaticResource RowT}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Width="34" Height="34" CornerRadius="8" Background="Transparent">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Path=(ui:Ext.Glyph), RelativeSource={RelativeSource TemplatedParent}}" FontSize="15" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SoftBrush}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextOnSurface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarRight" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNarrow}" Value="True">
                    <Setter Property="Grid.Column" Value="0"/>
                    <Setter Property="Grid.Row" Value="1"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="Margin" Value="0,12,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Margin="32,14,32,0">
            <TextBlock Text="Library" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}" Margin="0,4,0,0"/>
        </StackPanel>
        <!-- toolbar -->
        <Grid x:Name="Toolbar" Grid.Row="1" Margin="32,16,32,16" Visibility="{Binding IsLibraryEmpty, Converter={StaticResource InvBoolVis}}" SizeChanged="Toolbar_SizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel x:Name="Chips" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0">
                <RadioButton Style="{StaticResource Chip}" GroupName="status" IsChecked="{Binding StatusFilter, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=All}" Command="{Binding SetStatusFilterCommand}" CommandParameter="All">
                    <TextBlock><Run Text="All  "/><Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Normal"/></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" GroupName="status" IsChecked="{Binding StatusFilter, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Favorites}" Command="{Binding SetStatusFilterCommand}" CommandParameter="Favorites">
                    <TextBlock><Run Text="★ Favorites  "/><Run Text="{Binding FavoriteCount, Mode=OneWay}" FontWeight="Normal"/></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" GroupName="status" IsChecked="{Binding StatusFilter, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Updates}" Command="{Binding SetStatusFilterCommand}" CommandParameter="Updates">
                    <TextBlock><Run Text="Updates  "/><Run Text="{Binding UpdateCount, Mode=OneWay}" FontWeight="Normal"/></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" GroupName="status" IsChecked="{Binding StatusFilter, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Installed}" Command="{Binding SetStatusFilterCommand}" CommandParameter="Installed">
                    <TextBlock><Run Text="Installed  "/><Run Text="{Binding InstalledCount, Mode=OneWay}" FontWeight="Normal"/></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" GroupName="status" IsChecked="{Binding StatusFilter, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=NotInstalled}" Command="{Binding SetStatusFilterCommand}" CommandParameter="NotInstalled">
                    <TextBlock><Run Text="Not installed  "/><Run Text="{Binding NotInstalledCount, Mode=OneWay}" FontWeight="Normal"/></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" GroupName="status" IsChecked="{Binding StatusFilter, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Hidden}" Command="{Binding SetStatusFilterCommand}" CommandParameter="Hidden"
                             Visibility="{Binding HiddenCount, Converter={StaticResource NullVis}}">
                    <TextBlock><Run Text="Hidden  "/><Run Text="{Binding HiddenCount, Mode=OneWay}" FontWeight="Normal"/></TextBlock>
                </RadioButton>
            </WrapPanel>
            <StackPanel x:Name="ToolbarControls" Orientation="Horizontal" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox Width="220" Style="{StaticResource SearchBox}" Text="{Binding LibraryFilterText, UpdateSourceTrigger=PropertyChanged}" ui:Ext.Hint="Search your library…"/>
                <ComboBox Width="150" Height="36" MinHeight="0" VerticalAlignment="Center" Margin="10,0,0,0" ItemsSource="{x:Static ui:MainViewModel.SortChoices}" SelectedItem="{Binding Settings.SortMode}" ToolTip="Sort by"/>
                <Button Margin="10,0,0,0" ToolTip="Group apps into sections" Command="{Binding ToggleGroupingCommand}" Content="&#xE8B7;" Width="36" Height="36" Padding="0" VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Settings.GroupItems}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextOnSurface}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Border Background="{DynamicResource SoftBrush}" CornerRadius="10" Padding="2" Margin="10,0,0,0" VerticalAlignment="Center" Height="40" Visibility="{Binding Settings.GroupItems, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE70E;" Width="34" Height="34" ToolTip="Fold all sections" Click="FoldAll_Click"/>
                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE70D;" Width="34" Height="34" ToolTip="Open all sections" Click="OpenAll_Click"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SoftBrush}" CornerRadius="10" Padding="2" Margin="10,0,0,0" VerticalAlignment="Center" Height="40">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource ViewToggle}" ui:Ext.Glyph="&#xE80A;" ToolTip="Grid view" Command="{Binding SetViewModeCommand}" CommandParameter="Grid"
                                     IsChecked="{Binding Settings.ViewMode, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Grid}"/>
                        <RadioButton Style="{StaticResource ViewToggle}" ui:Ext.Glyph="&#xE8FD;" ToolTip="List view" Command="{Binding SetViewModeCommand}" CommandParameter="List"
                                     IsChecked="{Binding Settings.ViewMode, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=List}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <!-- groups: one row of chips (drop an app on one to move it), plus new group / automatic groups -->
            <!-- platforms: appears once there is more than one (Windows today; room for the rest) -->
            <ui:ChipStrip Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" Visibility="{Binding HasPlatforms, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding Platforms}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource Chip}" GroupName="libPlatform" FontSize="12.5" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding SetPlatformCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding Name}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:ChipStrip>
            <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ui:ChipStrip>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Chip}" GroupName="libGroup" FontSize="12.5" Content="All groups" IsChecked="{Binding NoGroupFilter, Mode=OneWay}" Command="{Binding ClearGroupFilterCommand}"/>
                        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="libGroup" FontSize="12.5" IsChecked="{Binding IsSelected, Mode=OneWay}" AllowDrop="True"
                                                 Command="{Binding SelectGroupCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"
                                                 Drop="GroupChip_Drop" DragEnter="GroupChip_DragEnter" DragLeave="GroupChip_DragLeave">
                                        <RadioButton.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Rename" Command="{Binding RenameGroupCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}" Visibility="{Binding IsCustom, Converter={StaticResource BoolVis}}">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="13"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Delete group" Command="{Binding DeleteGroupCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}" Visibility="{Binding IsCustom, Converter={StaticResource BoolVis}}">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13"/></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </RadioButton.ContextMenu>
                                        <TextBlock><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Count, Mode=OneWay}" FontWeight="Normal"/></TextBlock>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:ChipStrip>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Command="{Binding ToggleAutoGroupsCommand}" Content="Auto" Height="30" MinHeight="0" Padding="12,0" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="ToolTip" Value="Automatic groups are off — click to sort apps into groups by type"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.AutoGroups}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextOnSurface}"/>
                                        <Setter Property="ToolTip" Value="Apps are sorted into groups by type automatically — click to turn that off"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Height="30" MinHeight="0" Padding="12,0" FontSize="12" ToolTip="Create your own group" Command="{Binding NewGroupCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,1,7,0"/><TextBlock Text="New group"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- content -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsLibraryEmpty, Converter={StaticResource InvBoolVis}}">
                <StackPanel>
                <ItemsControl x:Name="Items" ItemsSource="{Binding LibraryView}" Margin="32,0,32,0" Focusable="False">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Tag" Value="{DynamicResource GridMinWidth}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Settings.ViewMode}" Value="List"><Setter Property="Tag" Value="100000"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ui:ResponsivePanel MinItemWidth="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Spacing="{DynamicResource PanelGap}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><ContentControl Content="{Binding}" Style="{StaticResource ItemHost}"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel Margin="0,0,0,24" Background="Transparent" AllowDrop="True" Drop="Section_Drop" DragEnter="Section_DragEnter" DragLeave="Section_DragLeave">
                                                    <ToggleButton x:Name="hdr" IsChecked="True" Cursor="Hand" Focusable="False" HorizontalAlignment="Left" Loaded="Hdr_Loaded" Click="Hdr_Click" ContextMenuOpening="Hdr_ContextMenuOpening">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent" Padding="0,4,12,4">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock x:Name="chev" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Foreground="{DynamicResource FaintBrush}" Margin="0,0,10,0"/>
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" FontSize="14.5" Foreground="{DynamicResource TextBrush}"/>
                                                                        <Border Background="{DynamicResource SoftBrush}" CornerRadius="9" Padding="8,1" Margin="10,1,0,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ItemCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DimBrush}"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="False"><Setter TargetName="chev" Property="Text" Value="&#xE76C;"/></Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <ItemsPresenter x:Name="items" Margin="0,10,0,0"/>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger SourceName="hdr" Property="IsChecked" Value="False"><Setter TargetName="items" Property="Visibility" Value="Collapsed"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding EmptyGroups}" Margin="32,0,32,32" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,24">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Foreground="{DynamicResource FaintBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" FontSize="14.5" Foreground="{DynamicResource TextBrush}"/>
                                    <Border Background="{DynamicResource SoftBrush}" CornerRadius="9" Padding="8,1" Margin="10,1,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DimBrush}"/>
                                    </Border>
                                </StackPanel>
                                <Border Margin="0,10,0,0" Padding="18,16" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource SoftBrush}">
                                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Text="Nothing here yet. Drag an app onto this group in the sidebar, or right-click an app and choose Move to group."/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- no matches -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoLibraryMatches, Converter={StaticResource BoolVis}}" Margin="0,0,0,80">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="34" Foreground="{DynamicResource FaintBrush}"/>
                <TextBlock Text="Nothing matches" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock Text="Try a different filter or clear the search box." Style="{StaticResource Dim}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- empty library -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolVis}}" Margin="24,0,24,60">
                <Border Width="84" Height="84" CornerRadius="26" HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#6C8CFF" Offset="0"/><GradientStop Color="#8A5CF6" Offset="1"/></LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="38" Foreground="White"/>
                </Border>
                <TextBlock Text="Your library is empty" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,24,0,8"/>
                <TextBlock Style="{StaticResource Dim}" TextAlignment="Center" FontSize="14"
                           Text="Paste a GitHub link into the bar above to track and install an app, search GitHub for something new, scan this PC for apps you already have, or restore a ReleaseSync backup."/>
                <WrapPanel HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Padding="20,0" Height="40" Command="{Binding NavigateCommand}" CommandParameter="Discover">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="14" Margin="0,0,9,0"/><TextBlock Text="Browse apps"/></StackPanel>
                    </Button>
                    <Button Padding="20,0" Height="40" Margin="10,0,0,0" Command="{Binding NavigateCommand}" CommandParameter="Scan">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" Margin="0,0,9,0"/><TextBlock Text="Scan this PC"/></StackPanel>
                    </Button>
                    <Button Padding="20,0" Height="40" Margin="10,0,0,0" Command="{Binding NavigateCommand}" CommandParameter="Import">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" FontSize="14" Margin="0,0,9,0"/><TextBlock Text="Import a list"/></StackPanel>
                    </Button>
                    <Button Padding="20,0" Height="40" Margin="10,0,0,0" Command="{Binding OpenStarsCommand}" ToolTip="Bring in the projects you've starred on GitHub">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="14" Margin="0,0,9,0"/><TextBlock Text="My GitHub stars"/></StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
