<UserControl x:Class="ReleaseSync.Views.DiscoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ReleaseSync.UI"
             xmlns:app="clr-namespace:ReleaseSync"
             xmlns:v="clr-namespace:ReleaseSync.Views">
    <UserControl.Resources>
        <!-- the "…" menu on every project card -->
        <ContextMenu x:Key="RepoMenu">
            <MenuItem Header="Details" Command="{Binding DetailsCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Save to try later" Command="{Binding ToggleTryLaterCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}" Visibility="{Binding IsTryLater, Converter={StaticResource InvBoolVis}}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Remove from try later" Command="{Binding ToggleTryLaterCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}" Visibility="{Binding IsTryLater, Converter={StaticResource BoolVis}}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="More from this developer" Command="{Binding OwnerCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Open project page" Command="{Binding GitHubCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="14"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- ================= top: title, tabs, categories, controls ================= -->
        <StackPanel Margin="32,14,32,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding SearchTitle}" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DiscoverBlurb}" Style="{StaticResource Dim}" Margin="0,4,0,0" Visibility="{Binding ShowPresets, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding SearchSummary}" Style="{StaticResource Dim}" Margin="0,4,0,0" Visibility="{Binding ShowPresets, Converter={StaticResource InvBoolVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- live count of GitHub requests left: amber when under a quarter, red when nearly gone, and it flashes each time it drops -->
                    <Border CornerRadius="10" Background="{DynamicResource SoftBrush}" Padding="12,4" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{Binding RateTip}" Visibility="{Binding HasRate, Converter={StaticResource BoolVis}}">
                        <Grid>
                            <Border x:Name="RateGlow" CornerRadius="10" Background="{DynamicResource DangerBrush}" Opacity="0" IsHitTestVisible="False" Margin="-12,-4,-12,-4"/>
                            <StackPanel>
                                <Grid HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding RateLeftText}" FontSize="22" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RateTone}" Value="mid"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding RateTone}" Value="low"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock x:Name="RateNumFlash" Text="{Binding RateLeftText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Opacity="0" IsHitTestVisible="False"/>
                                </Grid>
                                <TextBlock Text="{Binding RateOfText}" Style="{StaticResource Faint}" FontSize="10.5"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button x:Name="HelpBtn" Style="{StaticResource IconButton}" Content="&#xE897;" Width="36" Height="36" Padding="0" Margin="0,0,10,0" ToolTip="How Discover uses your GitHub requests" Click="Help_Click"/>
                    <Button x:Name="TryBtn" Style="{StaticResource OutlineButton}" Height="36" Padding="14,0" Click="TryBtn_Click" ToolTip="Projects you saved to look at later" Visibility="{Binding ShowPresets, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="14" Margin="0,1,9,0"/>
                            <TextBlock Text="Try later"/>
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="9" MinWidth="20" Height="20" Padding="6,0" Margin="9,0,0,0" Visibility="{Binding HasTryLater, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding TryLaterCount}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Width="36" Height="36" Padding="0" Margin="8,0,0,0" ToolTip="Refresh these lists" Command="{Binding RefreshDiscoverCommand}" Visibility="{Binding ShowPresets, Converter={StaticResource BoolVis}}"/>
                    <Button Content="Back to browse" Height="36" Padding="16,0" Click="Back_Click" Visibility="{Binding ShowPresets, Converter={StaticResource InvBoolVis}}"/>
                </StackPanel>
                <Popup x:Name="HelpPop" PlacementTarget="{Binding ElementName=HelpBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Margin="14" Width="440" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="18">
                        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Color="Black"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="How Discover uses your GitHub requests" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" FontSize="12.5" Text="{Binding DiscoverIntroLimit}"/>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" FontSize="12.5" Text="• First time in a category: roughly 100 to 250 requests. After that it is remembered for hours or days."/>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,3,0,0" FontSize="12.5" Text="• Hiding projects with no Windows download: about 1 request each, remembered for 3 days."/>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,3,0,0" FontSize="12.5" Text="• Full mode also prepares the other tabs in the background so they open instantly. Light mode skips that and shows 15 projects per list — a fraction of the requests."/>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,3,0,0" FontSize="12.5" Text="• The counter turns amber, then red, as it runs down. Below 1,500 left the background work stops; below 150 the Windows check pauses — so there is always enough left to check your apps for updates."/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Create a free token" Height="34" Padding="16,0" Visibility="{Binding NoToken, Converter={StaticResource BoolVis}}" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/settings/tokens" Click="HelpClose_Click"/>
                                <Button Content="Open GitHub settings" Height="34" Padding="14,0" Margin="8,0,0,0" Visibility="{Binding NoToken, Converter={StaticResource BoolVis}}" Command="{Binding OpenTokenSettingsCommand}" Click="HelpClose_Click"/>
                                <Button Content="Settings → GitHub" Height="34" Padding="14,0" Visibility="{Binding NoToken, Converter={StaticResource InvBoolVis}}" Command="{Binding OpenTokenSettingsCommand}" Click="HelpClose_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
                <Popup x:Name="TryPop" PlacementTarget="{Binding ElementName=TryBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Margin="14" Width="380" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="14">
                        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Color="Black"/></Border.Effect>
                        <StackPanel>
                            <Grid Margin="2,0,2,10">
                                <TextBlock Text="Saved to try later" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Content="Open Try later" Command="{Binding NavigateCommand}" CommandParameter="TryLater" Click="TryRow_Click"/>
                            </Grid>
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasTryLater, Converter={StaticResource BoolVis}}">
                                <ItemsControl ItemsSource="{Binding TryLaterList}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ContentControl ContentTemplate="{StaticResource AvatarTemplate}" Content="{Binding}" Width="32" Height="32"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Repo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Category}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="Add" Height="28" MinHeight="0" Padding="12,0" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                                                        Command="{Binding AddFromTryLaterCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}" Click="TryRow_Click"/>
                                                <Button Grid.Column="3" Style="{StaticResource SmallIconButton}" Content="&#xE711;" Margin="4,0,0,0" ToolTip="Remove from this list" VerticalAlignment="Center"
                                                        Command="{Binding RemoveTryLaterCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="Nothing saved yet. Use the “…” menu on any project and choose Save to try later." Style="{StaticResource Dim}" Margin="2,2,2,4" Visibility="{Binding NoTryLater, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- first visit: what Discover costs, in plain words -->
            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,16,0,0" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentSoftStrongBrush}" Visibility="{Binding ShowDiscoverIntro, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="16" Foreground="{DynamicResource AccentTextOnSurface}" Margin="0,1,10,0"/>
                        <TextBlock Text="Before you browse: Discover uses your GitHub request allowance" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" FontSize="12.5" Text="{Binding DiscoverIntroLimit}"/>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" FontSize="12.5"
                               Text="• Opening a category for the first time typically uses 100 to 250 requests. After that it is remembered for hours or days, so repeat visits use almost none."/>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,3,0,0" FontSize="12.5"
                               Text="• Hiding projects with no Windows download checks each one once (about 1 request each). ReleaseSync also prepares the other tabs in the background so they open instantly."/>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,3,0,0" FontSize="12.5"
                               Text="• The counter at the top right shows what is left, goes amber then red, and flashes whenever it drops. When you are running low ReleaseSync pauses the extras so it can still check your apps for updates."/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Visibility="{Binding NoToken, Converter={StaticResource BoolVis}}">
                        <Button Style="{StaticResource PrimaryButton}" Content="Create a free token" Height="34" Padding="16,0" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/settings/tokens"/>
                        <Button Content="I have one — add it" Height="34" Padding="16,0" Margin="8,0,0,0" Command="{Binding OpenTokenSettingsCommand}"/>
                        <TextBlock Style="{StaticResource Faint}" Margin="12,0,0,0" VerticalAlignment="Center" Text="Free, takes a minute, needs no special permissions."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Got it" Height="34" Padding="18,0" Command="{Binding DismissDiscoverIntroCommand}"/>
                        <Button Content="Use light mode" Height="34" Padding="16,0" Margin="8,0,0,0" Command="{Binding UseLightModeCommand}" ToolTip="About a third of the requests"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- browsing without a token -->
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,16,0,0" Background="{DynamicResource WarnSoftBrush}" Visibility="{Binding ShowTokenNudge, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" Foreground="{DynamicResource WarnBrush}" Margin="0,2,12,0" VerticalAlignment="Top"/>
                        <TextBlock TextWrapping="Wrap" MaxWidth="760" VerticalAlignment="Center"
                                   Text="You are browsing without a GitHub token, so GitHub allows only 60 requests an hour and Discover can run out in a few clicks — leaving none for update checks. A free token raises that to 5,000."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Content="Create a free token" Height="32" MinHeight="0" Padding="14,0" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/settings/tokens"/>
                        <Button Content="Add it" Height="32" MinHeight="0" Padding="14,0" Margin="8,0,0,0" Command="{Binding OpenTokenSettingsCommand}"/>
                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE711;" Margin="6,0,0,0" ToolTip="Not now" Command="{Binding DismissTokenNudgeCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- nearly out of requests -->
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,16,0,0" Background="{DynamicResource DangerSoftBrush}" Visibility="{Binding HasRateWarning, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource DangerBrush}" Margin="0,2,12,0" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding RateWarning}" TextWrapping="Wrap" MaxWidth="900"/>
                </StackPanel>
            </Border>

            <!-- picking the right project for an app that was linked to the wrong one -->
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0" Background="{DynamicResource WarnSoftBrush}" Visibility="{Binding HasRelink, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RelinkText}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="Cancel" Height="34" Padding="16,0" Margin="16,0,0,0" Command="{Binding CancelRelinkCommand}"/>
                </Grid>
            </Border>

            <!-- browse controls -->
            <StackPanel Visibility="{Binding ShowPresets, Converter={StaticResource BoolVis}}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource SoftBrush}" CornerRadius="12" Padding="3">
                        <ItemsControl ItemsSource="{x:Static ui:MainViewModel.DiscoverModes}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource SegTab}" GroupName="discoverMode" Content="{Binding Label}" Command="{Binding SetDiscoverModeCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding Value}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{x:Static v:SectionChecked.Instance}" Mode="OneWay">
                                                <Binding Path="Value"/>
                                                <Binding Path="Settings.DiscoverMode" Source="{x:Static app:App.VM}"/>
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource SoftBrush}" CornerRadius="12" Padding="3" Visibility="{Binding ShowRankControls, Converter={StaticResource BoolVis}}" ToolTip="Compare with an earlier ranking">
                        <ItemsControl ItemsSource="{x:Static ui:MainViewModel.DiscoverCompareChoices}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource SegTab}" FontSize="12.5" GroupName="discoverCompare" Content="{Binding Label}" Command="{Binding SetDiscoverCompareCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding Value}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{x:Static v:SectionChecked.Instance}" Mode="OneWay">
                                                <Binding Path="Value"/>
                                                <Binding Path="Settings.DiscoverCompare" Source="{x:Static app:App.VM}"/>
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>

                <!-- your GitHub stars -->
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,2,0,6" Background="{DynamicResource CardBrush}" Visibility="{Binding IsStarsMode, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="15" Foreground="{DynamicResource WarnBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="GitHub username" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                            <TextBox Width="190" Text="{Binding Settings.StarsUser, UpdateSourceTrigger=LostFocus}" ui:Ext.Hint="your-username" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Sync stars" Height="36" Padding="16,0" Margin="10,0,0,0" Command="{Binding SyncStarsCommand}" IsEnabled="{Binding CanSyncStars}"/>
                        </StackPanel>
                        <TextBox Grid.Column="2" MinWidth="200" MaxWidth="320" HorizontalAlignment="Right" Text="{Binding StarsFilter, UpdateSourceTrigger=PropertyChanged}" ui:Ext.Hint="Filter your stars…" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </Grid>
                </Border>
                <ui:ChipStrip Margin="0,12,0,0" Visibility="{Binding ShowRankControls, Converter={StaticResource BoolVis}}">
                    <ItemsControl ItemsSource="{x:Static ui:MainViewModel.DiscoverCategories}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource Chip}" GroupName="discoverCategory" Content="{Binding Label}" Command="{Binding SetDiscoverCategoryCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding Value}" FontSize="12.5">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{x:Static v:SectionChecked.Instance}" Mode="OneWay">
                                            <Binding Path="Value"/>
                                            <Binding Path="Settings.DiscoverCategory" Source="{x:Static app:App.VM}"/>
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:ChipStrip>
                <Grid Margin="2,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.DiscoverWindowsOnly}" Command="{Binding ReloadDiscoverCommand}" VerticalAlignment="Center"/>
                        <TextBlock Text="Only projects with Windows downloads" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12.5"/>
                        <TextBlock Style="{StaticResource Faint}" Margin="10,0,0,0" VerticalAlignment="Center" Text="· needs a GitHub token" Visibility="{Binding DiscoverNeedsToken, Converter={StaticResource BoolVis}}"/>
                        <Border Background="{DynamicResource SoftBrush}" CornerRadius="10" Padding="2" Margin="18,0,0,0" VerticalAlignment="Center" >
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegTab}" FontSize="12" Padding="0" Content="Full" ToolTip="36 per list · other tabs prepared ahead" GroupName="discoverUse" Command="{Binding SetDiscoverLightCommand}" CommandParameter="Full"
                                             IsChecked="{Binding Settings.DiscoverLight, Mode=OneWay, Converter={StaticResource Inv}}"/>
                                <RadioButton Style="{StaticResource SegTab}" FontSize="12" Padding="0" Content="Light" ToolTip="15 per list · fewest requests" GroupName="discoverUse" Command="{Binding SetDiscoverLightCommand}" CommandParameter="Light"
                                             IsChecked="{Binding Settings.DiscoverLight, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding DiscoverStatus}" Style="{StaticResource Faint}" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,16,0,0"/>
        </StackPanel>

        <!-- ================= results ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,18,32,32">
            <!-- developer profile (when browsing one developer's projects) -->
            <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,18,0,0" Background="{DynamicResource CardBrush}" Visibility="{Binding HasOwnerProfile, Converter={StaticResource BoolVis}}">
                <Grid DataContext="{Binding OwnerProfile}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ContentControl ContentTemplate="{StaticResource AvatarTemplate}" Content="{Binding}" Width="64" Height="64" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource H2}"/>
                            <Border Background="{DynamicResource SoftBrush}" CornerRadius="9" Padding="9,2" Margin="12,2,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindText}" FontSize="11.5" Foreground="{DynamicResource DimBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Bio}" Style="{StaticResource Dim}" Margin="0,5,0,0" MaxHeight="40" TextTrimming="CharacterEllipsis" Visibility="{Binding HasBio, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding StatsText}" Style="{StaticResource Faint}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="View on GitHub" VerticalAlignment="Top" Height="34" Padding="14,0" Command="{Binding OpenUrlCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding HtmlUrl}"/>
                </Grid>
            </Border>
                <ProgressBar IsIndeterminate="True" Margin="0,0,0,16" Visibility="{Binding SearchBusy, Converter={StaticResource BoolVis}}"/>
                <Border Style="{StaticResource Card}" Background="{DynamicResource DangerSoftBrush}" Padding="16,12" Margin="0,0,0,16" Visibility="{Binding HasSearchError, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{DynamicResource DangerBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding SearchError}" TextWrapping="Wrap" MaxWidth="760"/>
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding SearchResults}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ui:ResponsivePanel MinItemWidth="{DynamicResource WideMinWidth}" Spacing="{DynamicResource PanelGap}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="card" Style="{StaticResource Card}" Padding="{DynamicResource CardPad}" Background="{DynamicResource CardBrush}" Cursor="Hand" MouseLeftButtonUp="Card_Click" ToolTip="Click for details">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <!-- chart position -->
                                    <StackPanel Width="40" Margin="0,2,10,0" VerticalAlignment="Top" Visibility="{Binding HasRank, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding RankText}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource DimBrush}"/>
                                        <Border CornerRadius="7" Padding="5,1" Margin="0,5,0,0" HorizontalAlignment="Center" Visibility="{Binding HasMove, Converter={StaticResource BoolVis}}" ToolTip="{Binding GainText}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SoftBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MoveKind}" Value="up"><Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding MoveKind}" Value="down"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding MoveKind}" Value="new"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding MoveText}" FontSize="10.5" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MoveKind}" Value="up"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding MoveKind}" Value="down"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding MoveKind}" Value="new"><Setter Property="Foreground" Value="{DynamicResource AccentTextOnSurface}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding GainShort}" FontSize="10.5" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource SuccessBrush}" ToolTip="{Binding GainText}" Visibility="{Binding HasGain, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                    <ContentControl Grid.Column="1" ContentTemplate="{StaticResource AvatarTemplate}" Content="{Binding}" Width="{DynamicResource AvatarSize}" Height="{DynamicResource AvatarSize}" VerticalAlignment="Top"/>
                                    <!-- title, description, facts: always the same three lines, so every card is the same height -->
                                    <StackPanel Grid.Column="2" Margin="14,0,10,0" ClipToBounds="True">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FullName}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="11" Margin="7,2,0,0" Foreground="{DynamicResource AccentTextOnSurface}" ToolTip="On your try-later list" Visibility="{Binding IsTryLater, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Dim}" FontSize="{DynamicResource CardTextSize}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                                   Height="{DynamicResource DescHeight}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Height="22">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="12" Foreground="{DynamicResource WarnBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StarsText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasWindows, Converter={StaticResource BoolVis}}" ToolTip="Has a download that installs on Windows">
                                                <TextBlock Text="Windows" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource SoftBrush}" CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasLanguage, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding Language}" FontSize="11" Foreground="{DynamicResource DimBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding StarredText}" Style="{StaticResource Faint}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasStarredText, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <Button x:Name="addBtn" Style="{StaticResource PrimaryButton}" Width="88" Height="{DynamicResource BtnHeight}" MinHeight="0" Padding="0" Content="Add"
                                                Command="{Binding AddResultCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE712;" HorizontalAlignment="Right" Margin="0,6,0,0" ToolTip="More" Click="RepoMore_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasRelink, Source={x:Static app:App.VM}}" Value="True">
                                    <Setter TargetName="addBtn" Property="Content" Value="Use this one"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTracked}" Value="True">
                                    <Setter TargetName="addBtn" Property="Content" Value="In library"/>
                                    <Setter TargetName="addBtn" Property="Style" Value="{StaticResource BaseButton}"/>
                                </DataTrigger>
                                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentSoftStrongBrush}"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Load more" HorizontalAlignment="Center" Margin="0,22,0,0" Height="38" Padding="24,0" Command="{Binding LoadMoreCommand}"
                        Visibility="{Binding CanLoadMore, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>