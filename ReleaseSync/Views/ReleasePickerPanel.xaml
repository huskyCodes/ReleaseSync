<UserControl x:Class="ReleaseSync.Views.ReleasePickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:ReleaseSync">
    <StackPanel>
        <TextBlock Text="No releases to choose from yet." Style="{StaticResource Dim}" Visibility="{Binding HasReleases, Converter={StaticResource InvBoolVis}}"/>
        <StackPanel Visibility="{Binding HasReleases, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Version" Style="{StaticResource Faint}" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding Releases}" SelectedItem="{Binding Selected, Mode=TwoWay}" MaxDropDownHeight="320"/>

            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0" Background="{DynamicResource InputBrush}" CornerRadius="10">
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding NotesText}" TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="{DynamicResource DimBrush}"/>
                </ScrollViewer>
            </Border>

            <TextBlock Text="File" Style="{StaticResource Faint}" Margin="0,12,0,5"/>
            <ComboBox ItemsSource="{Binding AssetChoices}" SelectedItem="{Binding SelectedAsset, Mode=TwoWay}" MaxDropDownHeight="260"/>
            <TextBlock Text="{Binding FileText}" Style="{StaticResource Faint}" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <WrapPanel Margin="0,12,0,0">
                <Button Style="{StaticResource PrimaryButton}" Height="36" Padding="16,0" Margin="0,0,8,0" Content="{Binding InstallText}" IsEnabled="{Binding CanAct}"
                        Visibility="{Binding ShowActions, Converter={StaticResource BoolVis}}"
                        Command="{Binding InstallPickedCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                <Button Height="36" Padding="16,0" IsEnabled="{Binding CanAct}" ToolTip="Download only, don't install"
                        Command="{Binding DownloadPickedCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Download file only"/></StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
