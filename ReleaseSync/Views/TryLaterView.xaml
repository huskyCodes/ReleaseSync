<UserControl x:Class="ReleaseSync.Views.TryLaterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ReleaseSync.UI"
             xmlns:app="clr-namespace:ReleaseSync">
    <UserControl.Resources>
        <DataTemplate x:Key="TryCardT">
                        <Border Style="{StaticResource Card}" Padding="{DynamicResource CardPad}" Background="{DynamicResource CardBrush}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ContentControl ContentTemplate="{StaticResource AvatarTemplate}" Content="{Binding}" Width="{DynamicResource AvatarSize}" Height="{DynamicResource AvatarSize}"/>
                                    <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Repo}" Style="{StaticResource H3}" FontSize="{DynamicResource CardTitleSize}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FullName}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,-4,-6,0">
                                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE946;" ToolTip="Repository details" Command="{Binding DetailsCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE77B;" ToolTip="More from this developer" Command="{Binding OwnerCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE8A7;" ToolTip="Open project page" Command="{Binding GitHubCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE711;" ToolTip="Remove from this list" Command="{Binding RemoveTryLaterCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource Dim}" FontSize="{DynamicResource CardTextSize}" TextTrimming="CharacterEllipsis" MaxHeight="{DynamicResource DescHeight}" Margin="{DynamicResource StatMargin}" Visibility="{Binding HasDescription, Converter={StaticResource BoolVis}}"/>
                                <WrapPanel Grid.Row="2" Margin="{DynamicResource StatMargin}">
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasStars, Converter={StaticResource BoolVis}}" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="12" Foreground="{DynamicResource WarnBrush}" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding StarsText}" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Border Background="{DynamicResource SoftBrush}" CornerRadius="9" Padding="9,2" Margin="0,0,12,0" Visibility="{Binding HasLanguage, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding Language}" FontSize="11.5" Foreground="{DynamicResource DimBrush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="9,2" Margin="0,0,12,0" ToolTip="Type of project">
                                        <TextBlock Text="{Binding Category}" FontSize="11.5" Foreground="{DynamicResource AccentTextOnSurface}"/>
                                    </Border>
                                    <TextBlock Text="{Binding SavedText}" Style="{StaticResource Faint}" VerticalAlignment="Center"/>
                                </WrapPanel>
                                <StackPanel Grid.Row="3" Margin="{DynamicResource ActionMargin}">
                                    <TextBox Text="{Binding Note, UpdateSourceTrigger=LostFocus}" ui:Ext.Hint="Add a note — who recommended it, why you want it…" MinHeight="{DynamicResource BtnHeight}" Padding="10,4" FontSize="{DynamicResource CardTextSize}"/>
                                    <Button Style="{StaticResource PrimaryButton}" Height="{DynamicResource BtnHeight}" MinHeight="0" Padding="16,0" Margin="0,8,0,0"
                                            Command="{Binding AddFromTryLaterCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,9,0"/><TextBlock Text="Add to library"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
        <DataTemplate x:Key="TryRowT">
            <Border Style="{StaticResource Card}" CornerRadius="12" Padding="{DynamicResource RowPad}" Background="{DynamicResource CardBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                        <ColumnDefinition Width="Auto" MinWidth="170"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl ContentTemplate="{StaticResource AvatarTemplate}" Content="{Binding}" Width="{DynamicResource RowAvatarSize}" Height="{DynamicResource RowAvatarSize}"/>
                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FullName}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="12" Foreground="{DynamicResource WarnBrush}" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="{Binding HasStars, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="{Binding StarsText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{Binding HasStars, Converter={StaticResource BoolVis}}"/>
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="8,1" ToolTip="Type of project">
                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource AccentTextOnSurface}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SavedText}" Style="{StaticResource Faint}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBox Grid.Column="3" Text="{Binding Note, UpdateSourceTrigger=LostFocus}" ui:Ext.Hint="Add a note…" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="{DynamicResource CardTextSize}" Padding="10,0" Height="{DynamicResource BtnHeight}" MinHeight="0"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Content="Add to library" Padding="14,0" Height="{DynamicResource BtnHeight}" MinHeight="0"
                                Command="{Binding AddFromTryLaterCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE946;" Margin="8,0,0,0" ToolTip="Repository details" Command="{Binding DetailsCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE77B;" ToolTip="More from this developer" Command="{Binding OwnerCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE8A7;" ToolTip="Open project page" Command="{Binding GitHubCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE711;" ToolTip="Remove from this list" Command="{Binding RemoveTryLaterCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>        <Style x:Key="ViewToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Width="34" Height="34" CornerRadius="8" Background="Transparent">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Path=(ui:Ext.Glyph), RelativeSource={RelativeSource TemplatedParent}}" FontSize="15" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SoftBrush}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextOnSurface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TryHost" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource TryCardT}"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Settings.TryViewMode, Source={x:Static app:App.VM}}" Value="List">
                    <Setter Property="ContentTemplate" Value="{StaticResource TryRowT}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="32,14,32,12">
            <TextBlock Text="Try later" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0" Text="Projects you want to look at — saved without adding or installing anything."/>
            <StackPanel Visibility="{Binding HasTryLater, Converter={StaticResource BoolVis}}">
                <!-- toolbar (same layout as Library) -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBox Width="300" Style="{StaticResource SearchBox}" Text="{Binding TryText, UpdateSourceTrigger=PropertyChanged}" ui:Ext.Hint="Search your saved projects…"/>
                    <ComboBox Grid.Column="1" Width="160" Height="36" MinHeight="0" VerticalAlignment="Center" Margin="10,0,0,0" ItemsSource="{x:Static ui:MainViewModel.TrySortChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.TrySort}" ToolTip="Sort by"/>
                    <Button Grid.Column="2" Margin="10,0,0,0" ToolTip="Group into sections by type" Command="{Binding ToggleTryGroupCommand}" Content="&#xE8B7;" Width="36" Height="36" Padding="0" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.TryGroup}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextOnSurface}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Grid.Column="3" Background="{DynamicResource SoftBrush}" CornerRadius="10" Padding="2" Margin="10,0,0,0" VerticalAlignment="Center" Height="40" Visibility="{Binding Settings.TryGroup, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE70E;" Width="34" Height="34" ToolTip="Fold all sections" Click="FoldAll_Click"/>
                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE70D;" Width="34" Height="34" ToolTip="Open all sections" Click="OpenAll_Click"/>
                        </StackPanel>
                    </Border>
                                        <Border Grid.Column="4" Background="{DynamicResource SoftBrush}" CornerRadius="10" Padding="2" Margin="10,0,0,0" VerticalAlignment="Center" Height="40" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource ViewToggle}" ui:Ext.Glyph="&#xE80A;" ToolTip="Grid view" Command="{Binding SetTryViewModeCommand}" CommandParameter="Grid"
                                         IsChecked="{Binding Settings.TryViewMode, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Grid}"/>
                            <RadioButton Style="{StaticResource ViewToggle}" ui:Ext.Glyph="&#xE8FD;" ToolTip="List view" Command="{Binding SetTryViewModeCommand}" CommandParameter="List"
                                         IsChecked="{Binding Settings.TryViewMode, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=List}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="5" Text="{Binding TryShownText}" Style="{StaticResource Faint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <ui:ChipStrip Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding TryTypes}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource Chip}" GroupName="tryType" Content="{Binding Label}" FontSize="12.5" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding SetTryTypeCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding Name}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:ChipStrip>
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasTryLater, Converter={StaticResource BoolVis}}">
            <ItemsControl x:Name="Items" ItemsSource="{Binding TryLaterList}" Margin="32,0,32,32" Focusable="False">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Tag" Value="{DynamicResource WideMinWidth}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Settings.TryViewMode}" Value="List"><Setter Property="Tag" Value="100000"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><ui:ResponsivePanel MinItemWidth="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Spacing="{DynamicResource PanelGap}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <StackPanel Margin="0,0,0,24">
                                                <ToggleButton x:Name="hdr" IsChecked="True" Cursor="Hand" Focusable="False" HorizontalAlignment="Left" Loaded="Hdr_Loaded" Click="Hdr_Click">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="Transparent" Padding="0,4,12,4">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock x:Name="chev" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Foreground="{DynamicResource FaintBrush}" Margin="0,0,10,0"/>
                                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" FontSize="14.5" Foreground="{DynamicResource TextBrush}"/>
                                                                    <Border Background="{DynamicResource SoftBrush}" CornerRadius="9" Padding="8,1" Margin="10,1,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ItemCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DimBrush}"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="False"><Setter TargetName="chev" Property="Text" Value="&#xE76C;"/></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <ItemsPresenter x:Name="items" Margin="0,10,0,0"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger SourceName="hdr" Property="IsChecked" Value="False"><Setter TargetName="items" Property="Visibility" Value="Collapsed"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate><ContentControl Content="{Binding}" Style="{StaticResource TryHost}"/></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,90" Visibility="{Binding NoTryMatches, Converter={StaticResource BoolVis}}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="34" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Nothing matches" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
            <TextBlock Text="Try a different search or type." Style="{StaticResource Dim}" HorizontalAlignment="Center"/>
            <Button Content="Clear filters" Height="36" Padding="18,0" Margin="0,16,0,0" HorizontalAlignment="Center" Command="{Binding ClearTryFiltersCommand}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="24,0,24,90" Visibility="{Binding NoTryLater, Converter={StaticResource BoolVis}}">
            <Border Width="84" Height="84" CornerRadius="42" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="36" Foreground="{DynamicResource AccentTextOnSurface}"/>
            </Border>
            <TextBlock Text="Nothing saved yet" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,22,0,8"/>
            <TextBlock Style="{StaticResource Dim}" TextAlignment="Center" FontSize="13.5"
                       Text="Heard about something but not sure yet? Click the clock icon on any Discover result, or choose “Try later” when you paste a link. It'll wait here — and show up marked when you browse."/>
            <Button Style="{StaticResource PrimaryButton}" Height="40" Padding="22,0" HorizontalAlignment="Center" Margin="0,20,0,0" Command="{Binding NavigateCommand}" CommandParameter="Discover">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="14" Margin="0,0,9,0"/><TextBlock Text="Browse apps"/></StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
