<UserControl x:Class="ReleaseSync.Views.AddDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ReleaseSync.UI"
             xmlns:app="clr-namespace:ReleaseSync">
    <Border Style="{StaticResource Card}" Width="580" MaxWidth="660" CornerRadius="18" Background="{DynamicResource SurfaceBrush}" Padding="0">
        <Border.Effect><DropShadowEffect BlurRadius="50" ShadowDepth="10" Opacity="0.45" Direction="270"/></Border.Effect>
        <Grid DataContext="{Binding AddPreview}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid Margin="28,24,20,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Add to library" Style="{StaticResource H2}" FontSize="20"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding CancelAddCommand, Source={x:Static app:App.VM}}" ToolTip="Close (Esc)"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="560">
                <StackPanel Margin="28,6,28,20">
                    <!-- loading -->
                    <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}" Margin="0,24,0,28">
                        <TextBlock Text="Looking up the repository and its latest release…" Style="{StaticResource Dim}" FontSize="13.5" Margin="0,0,0,16"/>
                        <ProgressBar IsIndeterminate="True"/>
                    </StackPanel>

                    <!-- error -->
                    <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="12" Padding="16,14" Margin="0,8,0,16" Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" FontSize="16" Foreground="{DynamicResource DangerBrush}" Margin="0,1,12,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" MaxWidth="460"/>
                        </StackPanel>
                    </Border>

                    <!-- content -->
                    <StackPanel Visibility="{Binding HasDraft, Converter={StaticResource BoolVis}}">
                        <Border Style="{StaticResource Card}" Padding="18,16" Background="{DynamicResource CardBrush}">
                            <Grid DataContext="{Binding Draft}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ContentControl ContentTemplate="{StaticResource AvatarTemplate}" Content="{Binding}" Width="52" Height="52" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="17"/>
                                    <TextBlock Text="{Binding FullName}" Style="{StaticResource Faint}" Margin="0,2,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Style="{StaticResource LinkButton}" Margin="0,0,16,0" Command="{Binding OwnerCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="11" Margin="0,1,6,0"/><TextBlock Text="More from this developer" FontSize="12"/></StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Dim}" Margin="0,8,0,0" MaxHeight="54" TextTrimming="CharacterEllipsis" Visibility="{Binding HasDescription, Converter={StaticResource BoolVis}}"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="10,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding LatestText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextOnSurface}"/>
                                        </Border>
                                        <Border Background="{DynamicResource SoftBrush}" CornerRadius="9" Padding="10,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{DynamicResource DimBrush}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Stars, Converter={StaticResource NullVis}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="12" Foreground="{DynamicResource WarnBrush}" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding StarsText}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Margin="4,14,0,0" Visibility="{Binding HasHints, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="AT A GLANCE" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Hints}" ItemTemplate="{StaticResource HintTemplate}" Focusable="False"/>
                        </StackPanel>

                        <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="10" Padding="14,11" Margin="0,14,0,0" Visibility="{Binding NoAssetWarning, Converter={StaticResource BoolVis}}">
                            <TextBlock TextWrapping="Wrap" Text="This release has no Windows installer or zip that ReleaseSync recognizes. You can still track it, or pick a file below."/>
                        </Border>

                        <TextBlock Text="VERSION AND FILE" Style="{StaticResource Label}" Margin="0,20,0,8"/>
                        <Border Style="{StaticResource Card}" Padding="16,14" Background="{DynamicResource CardBrush}">
                            <local:ReleasePickerPanel xmlns:local="clr-namespace:ReleaseSync.Views" DataContext="{Binding Picker}"/>
                        </Border>
                        <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0" TextWrapping="Wrap" Text="The newest release is selected. Pick an older one to start from a specific version."/>

                        <TextBlock Text="GROUP" Style="{StaticResource Label}" Margin="0,20,0,8"/>
                        <ComboBox ItemsSource="{Binding Groups}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding GroupKey}"/>

                        <StackPanel Visibility="{Binding AlreadyHave, Converter={StaticResource InvBoolVis}}">
                            <TextBlock Text="INSTALL LOCATION" Style="{StaticResource Label}" Margin="0,20,0,8"/>
                            <Border Style="{StaticResource Card}" Padding="16,14" Background="{DynamicResource CardBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding InstallDirText}" TextWrapping="Wrap" FontSize="13" ToolTip="{Binding InstallDirText}"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Height="34" Padding="14,0" Margin="0,0,8,0" Command="{Binding ChooseInstallDirCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Choose a folder…"/></StackPanel>
                                        </Button>
                                        <Button Height="34" Padding="14,0" Style="{StaticResource OutlineButton}" Content="Use the default" Visibility="{Binding HasInstallDir, Converter={StaticResource BoolVis}}"
                                                Command="{Binding ResetInstallDirCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Text="Portable apps are unpacked into this folder. Setup programs are asked to use it — most do, but a few ignore the request. If the folder you pick isn't empty, the app gets its own sub-folder inside it. Updates go to the same place."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="ALREADY ON THIS PC?" Style="{StaticResource Label}" Margin="0,20,0,8"/>
                        <Border Style="{StaticResource Card}" Padding="16,4,16,14" Background="{DynamicResource CardBrush}">
                            <StackPanel>
                                <ui:SettingRow Title="I already have this" Description="Don't download it again — just track it and tell me when a newer version comes out.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AlreadyHave}"/>
                                </ui:SettingRow>
                                <StackPanel Visibility="{Binding AlreadyHave, Converter={StaticResource BoolVis}}">
                                    <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="10" Padding="12,9" Margin="0,12,0,0" Visibility="{Binding HasDetected, Converter={StaticResource BoolVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                            <TextBlock Text="{Binding DetectedText}" TextWrapping="Wrap" MaxWidth="440" FontSize="12.5"/>
                                        </StackPanel>
                                    </Border>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Version you have" FontWeight="SemiBold"/>
                                            <TextBlock Text="Leave blank if it's the latest — ReleaseSync will assume so and only offer newer releases." Style="{StaticResource Faint}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding HaveVersion, UpdateSourceTrigger=PropertyChanged}" ui:Ext.Hint="e.g. 1.2.3"/>
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="Where it lives" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ExePathText}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePathText}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Locate…" Height="36" Padding="16,0" Command="{Binding LocateExistingCommand, Source={x:Static app:App.VM}}"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ui:SettingRow Title="Include pre-releases" Description="Also track beta and nightly builds." Margin="0,8,0,0">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IncludePre}"/>
                        </ui:SettingRow>
                        <ui:SettingRow Title="Install after adding" Description="Download and install this release right away." IsEnabled="{Binding CanChooseInstall}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding InstallNow}"/>
                        </ui:SettingRow>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,16">
                <Grid>
                <Button HorizontalAlignment="Left" Height="40" Padding="16,0" Style="{StaticResource OutlineButton}" Command="{Binding PreviewTryLaterCommand, Source={x:Static app:App.VM}}"
                        ToolTip="Save to try later instead">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding TryLaterGlyph}" FontSize="13" Margin="0,0,9,0"/>
                        <TextBlock Text="{Binding TryLaterText}"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Height="40" Padding="22,0" Command="{Binding CancelAddCommand, Source={x:Static app:App.VM}}"/>
                    <Button Style="{StaticResource PrimaryButton}" Height="40" Padding="24,0" Margin="10,0,0,0" IsEnabled="{Binding CanConfirm}"
                            Command="{Binding ConfirmAddCommand, Source={x:Static app:App.VM}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,9,0"/>
                            <TextBlock Text="{Binding PrimaryText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
