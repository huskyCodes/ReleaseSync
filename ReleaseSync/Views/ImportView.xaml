<UserControl x:Class="ReleaseSync.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ReleaseSync.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,14,32,32" MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock Text="Import &amp; Export" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,20" Text="Restore a ReleaseSync backup, add a whole set of project links at once, or back up your library."/>

            <ui:ResponsivePanel MinItemWidth="480" Spacing="16">
                <!-- import -->
                <Border Style="{StaticResource Card}" Padding="24" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{DynamicResource AccentTextOnSurface}"/>
                            </Border>
                            <TextBlock Text="Import apps" Style="{StaticResource H2}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border x:Name="Drop" AllowDrop="True" Drop="Drop_Drop" DragEnter="Drop_Enter" DragLeave="Drop_Leave" Margin="0,18,0,0" CornerRadius="12" Cursor="Hand"
                                Background="{DynamicResource InputBrush}" BorderThickness="1.5" MouseLeftButtonUp="Drop_Click" Padding="20,24">
                            <Border.BorderBrush>
                                <DrawingBrush Viewport="0,0,8,8" ViewportUnits="Absolute" TileMode="Tile">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="{DynamicResource FaintBrush}"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,50,50"/><RectangleGeometry Rect="50,50,50,50"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Border.BorderBrush>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="26" Foreground="{DynamicResource AccentTextOnSurface}"/>
                                <TextBlock Text="Drop a ReleaseSync backup or a list of links" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                                <TextBlock Text="or click to browse files (.json, .txt)" Style="{StaticResource Faint}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="OR PASTE LINKS" Style="{StaticResource Label}" Margin="0,18,0,8"/>
                        <TextBox Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="110" MaxHeight="180"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" ui:Ext.Hint="https://github.com/owner/repo&#10;owner/another-repo"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Put imported apps in" FontWeight="SemiBold"/>
                                <TextBlock Text="Leave on automatic to keep their original groups" Style="{StaticResource Faint}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ImportGroupOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ImportGroup}"/>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Already installed on this PC" FontWeight="SemiBold"/>
                                <TextBlock Text="Track updates only — don't offer to install the current version" Style="{StaticResource Faint}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding ImportMarkInstalled}"/>
                        </Grid>
                        <Grid Margin="0,14,0,0" IsEnabled="{Binding ImportMarkInstalled, Converter={StaticResource Inv}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Install everything after importing" FontWeight="SemiBold"/>
                                <TextBlock Text="Downloads and installs each app one after another" Style="{StaticResource Faint}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding ImportInstall}"/>
                        </Grid>

                        <Button Style="{StaticResource PrimaryButton}" Height="42" Margin="0,22,0,0" Command="{Binding ImportTextCommand}" IsEnabled="{Binding IsImporting, Converter={StaticResource Inv}}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" Margin="0,0,9,0"/><TextBlock Text="Import"/></StackPanel>
                        </Button>
                        <ProgressBar IsIndeterminate="True" Margin="0,14,0,0" Visibility="{Binding IsImporting, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding ImportStatus}" Style="{StaticResource Dim}" Margin="0,12,0,0" Visibility="{Binding HasImportStatus, Converter={StaticResource BoolVis}}"/>
                        <Border Background="{DynamicResource SoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,16,0,0" Visibility="{Binding Settings.HasToken, Converter={StaticResource InvBoolVis}}">
                            <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Text="Tip: without a GitHub token, GitHub allows about 60 requests an hour. Each imported app uses two, so add a token in Settings → GitHub before importing big lists."/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- export -->
                <Border Style="{StaticResource Card}" Padding="24" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" Foreground="{DynamicResource AccentTextOnSurface}"/>
                            </Border>
                            <TextBlock Text="Export your library" Style="{StaticResource H2}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Dim}" Margin="0,16,0,18" Text="Save a backup of everything you track — groups and pre-release preferences included — or share a plain list of links."/>
                        <Button Height="42" Command="{Binding ExportJsonCommand}" HorizontalContentAlignment="Left" Padding="16,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="14" Margin="0,0,12,0"/><TextBlock Text="Export as ReleaseSync backup (.json)"/></StackPanel>
                        </Button>
                        <Button Height="42" Margin="0,10,0,0" Command="{Binding ExportLinksCommand}" HorizontalContentAlignment="Left" Padding="16,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="14" Margin="0,0,12,0"/><TextBlock Text="Export as link list (.txt)"/></StackPanel>
                        </Button>
                        <Button Height="42" Margin="0,10,0,0" Command="{Binding CopyLinksCommand}" HorizontalContentAlignment="Left" Padding="16,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="14" Margin="0,0,12,0"/><TextBlock Text="Copy all links to clipboard"/></StackPanel>
                        </Button>

                        <TextBlock Text="WHAT CAN BE IMPORTED" Style="{StaticResource Label}" Margin="0,28,0,10"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,10,0"/><TextBlock Text="ReleaseSync backups (made with Export on this page)" Style="{StaticResource Dim}"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,10,0"/><TextBlock Text="Any text with GitHub, GitLab or Codeberg links" Style="{StaticResource Dim}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,10,0"/><TextBlock Text="Plain owner/repo lines" Style="{StaticResource Dim}"/></StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ui:ResponsivePanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
