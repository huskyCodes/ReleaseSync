<UserControl x:Class="ReleaseSync.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ReleaseSync.UI"
             xmlns:app="clr-namespace:ReleaseSync">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,14,32,28" MaxWidth="1100" HorizontalAlignment="Stretch">
                <TextBlock Text="Scan this PC" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,18" Text="Find apps you already have that come from GitHub, and link them here so ReleaseSync can tell you when updates are out."/>

                <!-- start card -->
                <Border Style="{StaticResource Card}" Padding="22,20" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="20" Foreground="{DynamicResource AccentTextOnSurface}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Look through installed programs" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Style="{StaticResource Dim}" Margin="0,3,0,0" Text="ReleaseSync reads the list of installed apps in Windows. Programs that link to their GitHub page are matched automatically; for the rest you can search GitHub by name."/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Cancel" Height="40" Padding="18,0" Margin="0,0,8,0" Command="{Binding CancelScanCommand}" Visibility="{Binding CanScan, Converter={StaticResource InvBoolVis}}"/>
                                <Button Style="{StaticResource PrimaryButton}" Height="40" Padding="22,0" Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,9,0"/><TextBlock Text="Scan now"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ProgressBar IsIndeterminate="True" Margin="0,16,0,0" Visibility="{Binding CanScan, Converter={StaticResource InvBoolVis}}"/>
                        <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Dim}" Margin="0,12,0,0" Visibility="{Binding HasScanStatus, Converter={StaticResource BoolVis}}"/>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource OutlineButton}" Height="34" Padding="14,0" Margin="0,0,8,6" Command="{Binding ScanWingetCommand}" IsEnabled="{Binding CanScan}"
                                    ToolTip="Also scan winget packages">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74C;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Also read winget packages"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource OutlineButton}" Height="34" Padding="14,0" Margin="0,0,8,6" Command="{Binding AddScanFolderCommand}"
                                    ToolTip="Look inside each sub-folder">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Add a folder to look in…"/></StackPanel>
                            </Button>
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding ScanFolderList}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SoftBrush}" CornerRadius="9" Padding="10,3,4,3" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource DimBrush}"/>
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE711;" Width="22" Height="22" FontSize="10" Margin="4,0,0,0" ToolTip="Stop looking here"
                                                    Command="{Binding RemoveScanFolderCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- nothing linked -->
                <Border Background="{DynamicResource SoftBrush}" CornerRadius="12" Padding="18,14" Margin="0,16,0,0" Visibility="{Binding ScanEmptyHint, Converter={StaticResource BoolVis}}">
                    <TextBlock Style="{StaticResource Dim}" FontSize="13"
                               Text="None of your installed programs link straight to GitHub. That's common — many projects don't put their repo in Windows. Use “Find on GitHub” below to look programs up by name."/>
                </Border>

                <!-- linked -->
                <Grid Margin="0,26,0,10" Visibility="{Binding HasLinked, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LinkedHeader}" Style="{StaticResource H3}" FontSize="15" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource LinkButton}" Content="Select all" Margin="0,0,16,0" Command="{Binding SelectAllScannedCommand}" CommandParameter="all"/>
                        <Button Style="{StaticResource LinkButton}" Content="Select none" Command="{Binding SelectAllScannedCommand}" CommandParameter="none"/>
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding ScanLinked}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="row" Style="{StaticResource Card}" CornerRadius="12" Padding="{DynamicResource CardPad}" Margin="0,0,0,10" Background="{DynamicResource CardBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <ContentControl Grid.Column="1" ContentTemplate="{StaticResource AvatarTemplate}" Content="{Binding}" Width="44" Height="44"/>
                                    <StackPanel Grid.Column="2" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
                                            <Border CornerRadius="9" Padding="8,1" Margin="10,1,0,0" VerticalAlignment="Center" Background="{DynamicResource SoftBrush}">
                                                <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{DynamicResource DimBrush}"/>
                                            </Border>
                                            <Border CornerRadius="9" Padding="8,1" Margin="6,1,0,0" VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}" Visibility="{Binding HasSourceText, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding SourceText}" FontSize="11" Foreground="{DynamicResource AccentTextOnSurface}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE943;" FontSize="11" Foreground="{DynamicResource FaintBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding FullName}" Style="{StaticResource Faint}" FontSize="12"/>
                                            <TextBlock Text="{Binding StarsText, StringFormat='   ★ {0}'}" Style="{StaticResource Faint}" FontSize="12" Visibility="{Binding HasStars, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Dim}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxHeight="20" Visibility="{Binding HasDescription, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="240">
                                        <TextBlock x:Name="st" Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12.5" TextAlignment="Right" TextWrapping="Wrap" Foreground="{DynamicResource DimBrush}"/>
                                        <TextBlock Text="{Binding Version, StringFormat='Installed: {0}'}" Style="{StaticResource Faint}" TextAlignment="Right" Margin="0,3,0,0" Visibility="{Binding Version, Converter={StaticResource NullVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasUpdate}" Value="True"><Setter TargetName="st" Property="Foreground" Value="{DynamicResource AccentTextOnSurface}"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsTracked}" Value="True"><Setter TargetName="row" Property="Opacity" Value="0.55"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- other programs -->
                <Grid Margin="0,28,0,10" Visibility="{Binding HasScanned, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding OtherHeader}" Style="{StaticResource H3}" FontSize="15"/>
                        <TextBlock Style="{StaticResource Faint}" Margin="0,3,0,0" TextWrapping="Wrap" Text="No GitHub link was found in these. “Find on GitHub” searches by name and shows how confident the match is — nothing is added until you tick it."/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Height="36" Padding="14,0" VerticalAlignment="Top" Margin="16,0,0,0"
                            Command="{Binding LookUpAllCommand}" IsEnabled="{Binding CanLookUpAll}" Content="{Binding LookUpAllText}"/>
                </Grid>
                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Left" Margin="0,0,0,12" Content="Hide Windows, Microsoft and driver components" IsChecked="{Binding HideSystem}" Visibility="{Binding HasScanned, Converter={StaticResource BoolVis}}"/>
                <ItemsControl ItemsSource="{Binding ScanOther}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" CornerRadius="10" Padding="{DynamicResource RowPad}" Margin="0,0,0,6" Background="{DynamicResource CardBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SoftBrush}">
                                        <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="{DynamicResource DimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding VersionText, Mode=OneWay}"/><Run Text="{Binding PublisherText, Mode=OneWay, StringFormat='   ·   {0}'}"/><Run Text="{Binding WhereText, Mode=OneWay, StringFormat='   ·   {0}'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding Note, Converter={StaticResource NullVis}}"/>
                                        <ProgressBar IsIndeterminate="True" Width="70" Margin="0,0,4,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                                        <Button Content="Link…" Height="32" Padding="14,0" Margin="0,0,6,0" Style="{StaticResource OutlineButton}" ToolTip="Paste the project's address"
                                                Command="{Binding LinkCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}" Visibility="{Binding IsBusy, Converter={StaticResource InvBoolVis}}"/>
                                        <Button Content="Find on GitHub" Height="32" Padding="14,0" Style="{StaticResource OutlineButton}" Command="{Binding LookUpCommand, Source={x:Static app:App.VM}}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsBusy, Converter={StaticResource InvBoolVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- add bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="32,14" Visibility="{Binding HasLinked, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Dim}" Text="Adding links each program to its GitHub page. Nothing gets reinstalled — ReleaseSync just starts tracking the version you have."/>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="42" Padding="24,0" Margin="16,0,0,0" Command="{Binding AddScannedCommand}" IsEnabled="{Binding CanAddScanned}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,9,0"/><TextBlock Text="{Binding AddScannedText}"/></StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
