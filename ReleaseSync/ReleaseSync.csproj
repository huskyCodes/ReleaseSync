<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows app: window, pages, installers, Windows Security checks, Credential Manager. Everything portable is in ReleaseSync.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ReleaseSync</AssemblyName>
    <RootNamespace>ReleaseSync</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>ReleaseSync</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <ProjectReference Include="..\ReleaseSync.Core\ReleaseSync.Core.csproj" />
  </ItemGroup>

</Project>