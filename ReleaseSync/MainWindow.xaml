<Window x:Class="ReleaseSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ReleaseSync.UI"
        xmlns:v="clr-namespace:ReleaseSync.Views"
        xmlns:app="clr-namespace:ReleaseSync"
        Title="ReleaseSync" Width="1280" Height="820" MinWidth="680" MinHeight="520"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseDrawerCommand}"/>
        <KeyBinding Key="F5" Command="{Binding CheckAllCommand}"/>
    </Window.InputBindings>

    <Grid x:Name="Root">
        <Grid.LayoutTransform><ScaleTransform x:Name="ScaleT" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="252"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Sidebar ============ -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12,14,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- brand -->
                    <Grid Margin="6,2,6,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6C8CFF" Offset="0"/><GradientStop Color="#8A5CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Foreground="White" FontSize="17"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsCompact, Converter={StaticResource InvBoolVis}}">
                            <TextBlock Text="ReleaseSync" Style="{StaticResource H2}" FontSize="17"/>
                            <TextBlock Text="Apps from GitHub, kept current" Style="{StaticResource Faint}" FontSize="10.5"/>
                        </StackPanel>
                    </Grid>

                    <!-- primary navigation -->
                    <StackPanel Grid.Row="1">
                        <RadioButton Style="{StaticResource NavButton}" Content="Library" ui:Ext.Glyph="&#xE8F1;" ToolTip="Library"
                                     IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Library}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Library"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="Updates" ui:Ext.Glyph="&#xE895;" ToolTip="Updates"
                                     ui:Ext.Badge="{Binding UpdateCount}"
                                     IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Updates}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Updates"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="Discover" ui:Ext.Glyph="&#xE774;" ToolTip="Discover"
                                     IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Discover}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Discover"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="Try later" ui:Ext.Glyph="&#xE823;" ToolTip="Try later"
                                     ui:Ext.Badge="{Binding TryLaterCount}"
                                     IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=TryLater}"
                                     Command="{Binding NavigateCommand}" CommandParameter="TryLater"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="Scan PC" ui:Ext.Glyph="&#xE721;" ToolTip="Scan this PC for apps that come from GitHub"
                                     IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Scan}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Scan"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="Import &amp; Export" ui:Ext.Glyph="&#xE8AB;" ToolTip="Import &amp; Export"
                                     IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Import}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Import"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="Activity" ui:Ext.Glyph="&#xE81C;" ToolTip="Activity"
                                     IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Activity}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Activity"/>
                    </StackPanel>

                    <!-- footer -->
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Height="40" Margin="0,0,0,8" Padding="10,0" Command="{Binding AskSelfUpdateCommand}" ToolTip="{Binding SelfUpdateText}" AutomationProperties.Name="Update available"
                                Visibility="{Binding HasSelfUpdate, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelfButtonText}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsCompact, Converter={StaticResource InvBoolVis}}"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource Card}" CornerRadius="11" Padding="12,10" Margin="0,0,0,8" Cursor="Hand"
                                Visibility="{Binding IsCompact, Converter={StaticResource InvBoolVis}}"
                                MouseLeftButtonUp="Rate_Click" ToolTip="GitHub API usage — click to manage your token">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RateLevel}" Value="low"><Setter Property="Fill" Value="{DynamicResource WarnBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding RateLevel}" Value="none"><Setter Property="Fill" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding RateText}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Text="{Binding RateHint}" Style="{StaticResource Faint}" Margin="16,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding RateHint, Converter={StaticResource NullVis}}"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <RadioButton Style="{StaticResource NavButton}" Content="Settings" ui:Ext.Glyph="&#xE713;" ToolTip="Settings" Margin="0"
                                         IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Settings}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE700;" ToolTip="Collapse or expand sidebar" Command="{Binding ToggleSidebarCommand}"
                                    Visibility="{Binding IsCompact, Converter={StaticResource InvBoolVis}}" Margin="4,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding AppVersionShort}" Style="{StaticResource Faint}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Visibility="{Binding IsCompact, Converter={StaticResource InvBoolVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Content ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <!-- top bar -->
                <Grid Margin="28,16,28,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" Content="&#xE700;" ToolTip="Show sidebar" Command="{Binding ToggleSidebarCommand}" Margin="0,0,10,0"
                            Visibility="{Binding IsCompact, Converter={StaticResource BoolVis}}"/>
                    <Border Grid.Column="1" Style="{StaticResource Card}" CornerRadius="12" MaxWidth="760" HorizontalAlignment="Stretch" Background="{DynamicResource InputBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{DynamicResource FaintBrush}"/>
                            <TextBox x:Name="Omnibox" Grid.Column="1" Style="{StaticResource BareTextBox}" Text="{Binding OmniboxText, UpdateSourceTrigger=PropertyChanged}"
                                     ui:Ext.Hint="Search GitHub, or paste a repository link to add it…" VerticalAlignment="Center" MinHeight="44">
                                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SubmitOmniboxCommand}"/></TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="6" Padding="16,0" Command="{Binding SubmitOmniboxCommand}"
                                    IsEnabled="{Binding OmniboxHasText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="13" Margin="0,0,8,0">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Icon}"><Setter Property="Text" Value="&#xE721;"/><Style.Triggers><DataTrigger Binding="{Binding OmniboxIsRepo}" Value="True"><Setter Property="Text" Value="&#xE710;"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding OmniboxActionText}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0">
                        <Button Style="{StaticResource OutlineButton}" Command="{Binding CheckAllCommand}" IsEnabled="{Binding IsChecking, Converter={StaticResource Inv}}" Height="44" Padding="14,0" ToolTip="Check all apps for updates (F5)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding CheckButtonText}" Visibility="{Binding IsNarrow, Converter={StaticResource InvBoolVis}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding UpdateAllCommand}" Height="44" Padding="16,0" Margin="8,0,0,0"
                                Visibility="{Binding UpdateCount, Converter={StaticResource NullVis}}" IsEnabled="{Binding IsUpdatingAll, Converter={StaticResource Inv}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock>
                                    <Run Text="Update all"/><Run Text=" ("/><Run Text="{Binding UpdateCount, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- pages -->
                <Grid Grid.Row="1">
                    <v:LibraryView Style="{StaticResource PageStyle}" Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Library}"/>
                    <v:UpdatesView Style="{StaticResource PageStyle}" Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Updates}"/>
                    <v:DiscoverView Style="{StaticResource PageStyle}" Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Discover}"/>
                    <v:TryLaterView Style="{StaticResource PageStyle}" Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=TryLater}"/>
                    <v:ScanView Style="{StaticResource PageStyle}" Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Scan}"/>
                    <v:ImportView Style="{StaticResource PageStyle}" Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Import}"/>
                    <v:ActivityView Style="{StaticResource PageStyle}" Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Activity}"/>
                    <v:SettingsView Style="{StaticResource PageStyle}" Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Settings}"/>                </Grid>
            </Grid>
        </Grid>

        <!-- ============ Detail drawer ============ -->
        <Grid x:Name="DrawerLayer" Visibility="Collapsed">
            <Border x:Name="DrawerScrim" Background="{DynamicResource ScrimBrush}" Opacity="0" MouseLeftButtonDown="Scrim_Click"/>
            <Border x:Name="Drawer" Width="440" HorizontalAlignment="Right" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                <Border.RenderTransform><TranslateTransform x:Name="DrawerT" X="460"/></Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.4"/></Border.Effect>
                <v:DetailDrawer DataContext="{Binding}"/>
            </Border>
        </Grid>

        <!-- ============ Modals ============ -->
        <Grid x:Name="ModalLayer" Visibility="Collapsed">
            <Border Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="ModalScrim_Click"/>
            <v:AddDialog Visibility="{Binding IsAddOpen, Converter={StaticResource BoolVis}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
            <v:RepoDialog Visibility="{Binding IsRepoOpen, Converter={StaticResource BoolVis}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
            <v:PromptDialog Visibility="{Binding IsPromptOpen, Converter={StaticResource BoolVis}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
        </Grid>

        <!-- ============ Toasts ============ -->
        <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="tb" Style="{StaticResource Card}" CornerRadius="12" Padding="14,12" Margin="0,8,0,0" MinWidth="260" MaxWidth="420" Background="{DynamicResource CardBrush}">
                        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.3" Direction="270"/></Border.Effect>
                        <Border.RenderTransform><TranslateTransform x:Name="tbt"/></Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="tg" Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource AccentTextOnSurface}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Content="&#xE711;" Margin="8,-4,-6,-4" VerticalAlignment="Top"
                                    Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="success"><Setter TargetName="tg" Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="error"><Setter TargetName="tg" Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="warn"><Setter TargetName="tg" Property="Foreground" Value="{DynamicResource WarnBrush}"/></DataTrigger>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="tb" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetName="tbt" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
